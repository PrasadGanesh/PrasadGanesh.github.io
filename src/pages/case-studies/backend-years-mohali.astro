---
const target = '/case-studies/ecommerce-payment-reconciliation/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p><a href={target}>Making e-commerce payments add up</a></p>
  </body>
</html>
