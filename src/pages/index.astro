---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemFlow from '../components/SystemFlow.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { site } from '../data/site';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const essays = (await getCollection('essays')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={site.title} description={site.description} jsonLd>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Data · Backend · Leadership</p>
      <h1 id="hero-title">
        Data and backend engineer. <em>I build the platforms teams run on, and I lead the people who build them.</em>
      </h1>
      <p class="proof">
        ~3.5 years building Python backends, then owned a data platform end to end. M.Tech, IIT Ropar.
      </p>
      <p class="cta">
        <a href="#work">Case studies</a>
        <a href="#contact">Contact</a>
      </p>
    </div>
    <SystemFlow />
  </section>

  <section aria-labelledby="work-kinds-title">
    <p class="eyebrow">What I do</p>
    <h2 id="work-kinds-title">Three kinds of systems</h2>
    <div class="grid g3">
      <div class="card">
        <h3>Data platforms</h3>
        <p>Spark, Airflow, time-series stores, pipelines</p>
      </div>
      <div class="card">
        <h3>Backend systems</h3>
        <p>FastAPI, Django, APIs, MongoDB, Postgres, Redis</p>
      </div>
      <div class="card">
        <h3>AI agents &amp; applied ML</h3>
        <p>Agents in production, detection models, evaluation</p>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="case-title">
    <p class="eyebrow">Case studies</p>
    <h2 id="case-title">Engineering and leadership stories</h2>
    <div class="grid g2">
      {
        studies.map((study) => (
          <CaseStudyCard
            href={`/case-studies/${study.id}/`}
            title={study.data.title}
            problem={study.data.problem}
            tried={study.data.tried}
            worked={study.data.worked}
            result={study.data.result}
          />
        ))
      }
    </div>
  </section>

  <section id="lead" aria-labelledby="lead-title">
    <p class="eyebrow">How I lead</p>
    <h2 id="lead-title">Habits, not titles</h2>
    <ul class="lead">
      <li><b>Design reviews</b> <span class="muted">— [placeholder]</span></li>
      <li><b>Mentoring</b> <span class="muted">— [placeholder]</span></li>
      <li><b>Simple tech choices</b> <span class="muted">— [placeholder]</span></li>
      <li><b>Release discipline</b> <span class="muted">— [placeholder]</span></li>
      <li><b>Unclear asks → specs</b> <span class="muted">— [placeholder]</span></li>
    </ul>
  </section>

  <section id="writing" aria-labelledby="writing-title">
    <p class="eyebrow">Writing</p>
    <h2 id="writing-title">Notes</h2>
    <div class="grid g3 notes">
      {
        essays.map((essay) => (
          <div class="card">
            <h3>
              <a href={`/writing/${essay.id}/`}>{essay.data.title}</a>
            </h3>
            <p>{essay.data.summary}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="foundations-title">
    <p class="eyebrow" id="foundations-title">Foundations</p>
    <p>
      M.Tech CS, IIT Ropar (2018–2020). Research on permutation-based indexing, KD-trees/quadtrees, and
      facial-expression recognition (78% accuracy).
    </p>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <p class="eyebrow" id="contact-title">Contact</p>
    <p class="cta">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={site.github}>GitHub</a>
    </p>
  </section>
</Base>
