---
const rows = [
  ['IRR', 'sample'],
  ['PAC', 'sample'],
  ['PR', 'sample'],
  ['SOIL', 'sample'],
  ['SOC', 'sample'],
  ['STRING', 'sample'],
  ['TEMP', 'sample'],
  ['GRID', 'sample'],
];
const tape = [...rows, ...rows];
---

<figure class="stream">
  <div class="stream__toolbar">
    <p class="kicker">Sample data</p>
    <label class="pause">
      <input class="stream-motion" type="checkbox" />
      <span class="pause__on">Pause sample animation</span>
      <span class="pause__off">Play sample animation</span>
    </label>
  </div>
  <div class="stream__stage">
    <svg viewBox="0 0 560 320" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="40" cy="42" r="12" stroke="var(--color-accent)"></circle>
        <g class="rays is-animated">
          <path d="M40 22v-8M40 62v8M20 42h-8M60 42h8M26 28l-6-6M54 28l6-6M26 56l-6 6M54 56l6 6"></path>
        </g>
        <path d="M92 34h64l12 20H104z"></path>
        <path d="M92 70h64l12 20H104z"></path>
        <path d="M92 106h64l12 20H104z"></path>
        <path class="flow is-animated" d="M168 44H214v150"></path>
        <path class="flow is-animated" d="M168 80H200"></path>
        <path class="flow is-animated" d="M168 116H188"></path>
        <rect x="214" y="168" width="84" height="44"></rect>
        <path class="flow is-animated" d="M298 184h48V116"></path>
        <rect x="346" y="70" width="30" height="92"></rect>
        <rect class="soc is-animated" x="350" y="74" width="22" height="84"></rect>
        <path class="flow is-animated" d="M298 198h40v52h78"></path>
        <path d="M416 236v28M402 250h28"></path>
      </g>
      <text x="256" y="195" text-anchor="middle">INV</text>
      <text x="361" y="180" text-anchor="middle">BESS</text>
      <text x="416" y="280" text-anchor="middle">GRID</text>
    </svg>
    <div class="tape" aria-hidden="true">
      <ul class="tape__track is-animated">
        {
          tape.map(([channel, value]) => (
            <li>
              <span>{channel}</span>
              <span>{value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption>Sample data. An illustration of a solar plant stream, not a live feed.</figcaption>
</figure>
