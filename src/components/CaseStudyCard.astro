---
interface Props {
  title: string;
  href: string;
  problem: string;
  tried: string;
  worked: string;
  result: string;
}

const { title, href, problem, tried, worked, result } = Astro.props;
---

<article class="card story">
  <h3><a href={href}>{title}</a></h3>
  <dl>
    <dt>Problem</dt>
    <dd>{problem}</dd>
    <dt>Tried</dt>
    <dd>{tried}</dd>
    <dt>Worked</dt>
    <dd>{worked}</dd>
    <dt>Result</dt>
    <dd>{result}</dd>
  </dl>
</article>
