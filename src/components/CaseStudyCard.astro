---
interface Props {
  title: string;
  href: string;
  problem: string;
  tried: string;
  worked: string;
  result: string;
}

const { title, href, problem, worked, result } = Astro.props;
---

<article class="card story">
  <h3><a href={href}>{title}</a></h3>
  <p class="story-problem">{problem}</p>
  <p class="story-worked"><span class="label">What worked</span>{worked}</p>
  <p class="story-result"><span class="label">Result</span>{result}</p>
  <span class="story-more" aria-hidden="true">Read the case study →</span>
</article>
