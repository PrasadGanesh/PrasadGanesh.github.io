---
import { nav, site } from '../data/site';
---

<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <a class="brand" href="/">{site.name}</a>
  <nav class="nav" aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
