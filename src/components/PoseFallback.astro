<script is:inline>
  (function () {
    if (CSS.supports("animation-timeline", "view()")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var nodes = document.querySelectorAll("[data-pose]");
    if (!nodes.length || typeof IntersectionObserver === "undefined") return;
    var watch = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          entries[i].target.classList.toggle("is-active", entries[i].isIntersecting);
        }
      },
      { rootMargin: "-15% 0px -35% 0px", threshold: 0.2 }
    );
    for (var n = 0; n < nodes.length; n++) watch.observe(nodes[n]);
  })();
</script>
