---
/**
 * Empty chart island.
 * Pass `dataset` (any JSON value) and optional `label` (default "sample data").
 * No chart library is loaded. A later chart should draw into [data-chart]
 * after the `livedemo:ready` event, whose detail is `{ dataset }`.
 */
interface Props {
  dataset?: unknown;
  label?: string;
}

const { dataset = null, label = 'sample data' } = Astro.props;
const payload = JSON.stringify(dataset).replace(/</g, '\\u003c');
---

<live-demo data-payload={payload} data-label={label}>
  <p class="kicker">{label}</p>
  <div class="live-demo__chart" data-chart>
    <p data-chart-note>Sample data. Chart slot is empty.</p>
  </div>
</live-demo>

<script>
  class LiveDemoElement extends HTMLElement {
    connectedCallback() {
      const raw = this.getAttribute('data-payload');
      let dataset: unknown = null;
      if (raw) {
        try {
          dataset = JSON.parse(raw);
        } catch {
          dataset = null;
        }
      }
      const chart = this.querySelector('[data-chart]');
      const note = this.querySelector('[data-chart-note]');
      if (chart instanceof HTMLElement) {
        chart.dataset.state = dataset == null ? 'empty' : 'ready';
      }
      if (note && dataset != null) {
        note.textContent = 'Sample data received. Chart renderer is not connected yet.';
      }
      this.dispatchEvent(
        new CustomEvent('livedemo:ready', {
          bubbles: true,
          detail: { dataset },
        }),
      );
    }
  }

  if (!customElements.get('live-demo')) {
    customElements.define('live-demo', LiveDemoElement);
  }
</script>
